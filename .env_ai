#natural language processing
SPELL_CHECK_DISTANCE=2

#timers
TIME_MINIMUM_AI_WAIT=1               #seconds

#SpaCy
SPACY_TOKENIZERS_PARALLELISM=false

# GENERATIVE MODEL PARAMETERS
MODEL_NAME=gemini-1.5-flash-001
MODEL_TEMP=0.7
MODEL_MAX_TOKEN=8000
MODEL_MAX_TOKEN_RESPONSE=8000
MODEL_TOP_P=0.95
MODEL_FREQUENCY_PENALTY=0
MODEL_PRESENCE_PENALTY=0

# PROMPT PARAMETERS
PROMPT_SUMMARY_LIMIT=1000
PROMPT_SUMMARY_METHOD=abstractive
PROMPT_INJECTION_MODELS=protectai/deberta-v3-base-prompt-injection-v2

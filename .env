#cloud account
CLD_PROJECT_ID=usfs-gcp-rand-test-3
CLD_BUCKET_ID=usfs-gcp-rand-test3-data-usc1
CLD_LOCATION=us-central1

#natural language processing
SPELL_CHECK_DISTANCE=2

#timers
TIME_MINIMUM_AI_WAIT=1               #seconds

#data
DATA_ROOT=/home/jupyter/projects/gcs
DATA_DIR=${DATA_ROOT}/source_data/nlp/${VERSION_NAME}
DATA_OUTPUT_DIR=${DATA_ROOT}/working_data/${VERSION_NAME}    

#input/output
EXCEL_CHAR_BOUNDARY=90
IO_DELIM=^
 
#data debugging
DEBUG=True
DEBUG_DATA=False
#version control
VERSION_NAME=docsum
VERSION_MAJOR=0
VERSION_MINOR=2
VERSION_RELEASE=0
#formatting
FORMAT_ENCODING=utf-8
FORMAT_TEXT_WIDTH=77
FORMAT_BOLD_START=\033[1m
FORMAT_BOLD_END=\033[0;0m
#SpaCy
SPACY_TOKENIZERS_PARALLELISM=false
#IMG
IMG_BACKGROUND=None                        #None without quotes or "black", "white", etc...
IMG_FONT_SIZE_MIN=14
IMG_WIDTH=1920
IMG_HEIGHT=1080

